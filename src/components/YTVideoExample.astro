---
import YoutubeVideo from "./YoutubeVideo";

interface Props {
    id: string;
    startTime?: number;
}

const {
    id,
    startTime,
} = Astro.props;
---

<details class="yt-video-example">

    <summary>
        <span class="yt-video-example__title">
            <slot />
        </span>

        <span class="yt-video-example__icon">
            ▶
        </span>
    </summary>


    <div class="yt-video-example__player">

        <YoutubeVideo
            id={id}
            title="YouTube video example"
            startTime={startTime}
        />

    </div>

</details>


<style>
    .yt-video-example {
        margin: 1.5rem 0;

        background: var(--surface);

        border: 1px solid var(--border);
        border-radius: var(--radius);

        overflow: hidden;
    }


    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 1rem;

        padding: 1rem 1.25rem;

        cursor: pointer;

        color: var(--text);

        list-style: none;

        transition:
            background var(--transition);
    }


    summary::-webkit-details-marker {
        display: none;
    }


    summary:hover {
        background: var(--surface-light);
    }


    .yt-video-example__title {
        font-weight: 600;
    }


    .yt-video-example__title :global(p) {
        margin: 0;
    }


    .yt-video-example__icon {
        color: var(--primary);

        transition:
            transform var(--transition);
    }


    details[open] .yt-video-example__icon {
        transform: rotate(90deg);
    }


    .yt-video-example__player {
        padding: 1rem 1.25rem 1.25rem;
        width: 80%
    }

    .yt-video-example__player {
    width: 100%;
    aspect-ratio: 16 / 9;

    padding: 0;
}

    .yt-video-example__player :global(iframe) {
        display: block;

        width: 100%;
        height: 100%;

        border: 0;
    }
</style>