---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title: string;
    showNavbar?: boolean;
    compactTopMargin?: boolean;
    shortSections?: boolean;
}

const {
    title,
    showNavbar = true,
    compactTopMargin = false,
    shortSections = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>

    <body>
        {showNavbar && <Navbar />}

        <main
            class:list={[
                "container",
                {
                    "container--compact-top": compactTopMargin,
                    "container--short-sections": shortSections,
                },
            ]}
        >
            <slot />
        </main>

        <Footer />
    </body>
</html>