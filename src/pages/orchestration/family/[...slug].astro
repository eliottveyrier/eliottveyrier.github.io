---
import MainLayout from "../../../layouts/MainLayout.astro";
import OrchestralSeatingNav from "../../../components/orchestration/OrchestralSeatingNav";

import { type CollectionEntry, getCollection, render } from "astro:content";
import OrchestraNav from "../../../components/orchestration/OrchestraNav";


export async function getStaticPaths() {
    const families = await getCollection("families");

    return families.map((family : CollectionEntry<"families">) => ({
        params: {
            slug: family.data.slug,
        },
        props: {
            family,
        },
    }));
}

interface Props {
    family: CollectionEntry<"families">;
}

const { family } = Astro.props;

const { Content } = await render(family);

const {
    fullName,
    sittingChartSections,
} = family.data;
---

<MainLayout title={fullName}>
    <main class="family-page">
        <section class="family-seating-chart">
            <OrchestraNav client:load fullName={fullName} members={family.data.members} />
        </section>

        <article class="family-content">
            <Content />
        </article>
    </main>
</MainLayout>
