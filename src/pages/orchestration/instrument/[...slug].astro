---
import MainLayout from "../../../layouts/MainLayout.astro";

import {
    type CollectionEntry,
    getCollection,
    render,
} from "astro:content";

import OrchestraNav from "../../../components/orchestration/OrchestraNav";

export async function getStaticPaths() {
    const instruments = await getCollection("instruments");

    return instruments.map(
        (instrument: CollectionEntry<"instruments">) => ({
            params: {
                slug: instrument.data.slug,
            },
            props: {
                instrument,
            },
        }),
    );
}

interface Props {
    instrument: CollectionEntry<"instruments">;
}

const { instrument } = Astro.props;

const families = await getCollection("families");

const family = instrument.data.family
    ? families.find(
          (family) =>
              family.data.slug === instrument.data.family,
      )
    : undefined;

const { Content } = await render(instrument);

const {
    fullName,
    sittingChartSections,
} = instrument.data;
---

<MainLayout title={fullName} compactTopMargin showBackButton>
    <main class="instrument-page">
        <section class="instrument-seating-chart">
            <OrchestraNav
                client:idle
                fullName={fullName}
                highlightList={sittingChartSections}
                family={instrument.data.family}
                familyLabel={family?.data.fullName}
                category={instrument.data.category}
            />
        </section>

        <article class="instrument-content">
            <Content />
        </article>
    </main>
</MainLayout>