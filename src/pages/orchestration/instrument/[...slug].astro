---
import MainLayout from "../../../layouts/MainLayout.astro";

import { type CollectionEntry, getCollection, render } from "astro:content";
import OrchestraNav from "../../../components/orchestration/OrchestraNav";


export async function getStaticPaths() {
    const instruments = await getCollection("instruments");

    return instruments.map((instrument : CollectionEntry<"instruments">) => ({
        params: {
            slug: instrument.data.slug,
        },
        props: {
            instrument,
        },
    }));
}

interface Props {
    instrument: CollectionEntry<"instruments">;
}

const { instrument } = Astro.props;

const { Content } = await render(instrument);

const {
    fullName,
    sittingChartSections,
} = instrument.data;
---

<MainLayout title={fullName}>
    <main class="instrument-page">

        <section class="instrument-seating-chart">
            <OrchestraNav client:load fullName={fullName} highlightList={instrument.data.sittingChartSections} />
        </section>

        <article class="instrument-content">
            <Content />
        </article>
    </main>
</MainLayout>